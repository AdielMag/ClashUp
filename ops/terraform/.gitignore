# Terraform state and local config — never commit. Contains live secrets
# (Mongo connection string, JWT signing keys) and machine-specific state.
*.tfvars
*.tfvars.json
!*.tfvars.example
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
# Saved plan files (terraform plan -out) bundle the full state + variable values,
# including the Mongo string and JWT keys, in plaintext. Never commit them.
tfplan
*.tfplan
*.plan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
