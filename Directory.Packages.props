<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="MagicOnion / gRPC">
    <PackageVersion Include="MagicOnion.Server" Version="7.10.0" />
    <PackageVersion Include="MagicOnion.Client" Version="7.10.0" />
    <PackageVersion Include="MagicOnion.Shared" Version="7.10.0" />
    <PackageVersion Include="MessagePack" Version="3.1.7" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.71.0" />
    <PackageVersion Include="Grpc.AspNetCore.Server" Version="2.71.0" />
  </ItemGroup>

  <ItemGroup Label="ASP.NET Core extensions">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Label="Auth / JWT">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.3.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.3.0" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <PackageVersion Include="MongoDB.Driver" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup Label="Telemetry">
    <PackageVersion Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.10.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.10.0" />
  </ItemGroup>

  <ItemGroup Label="GCP client libraries">
    <PackageVersion Include="Google.Cloud.Monitoring.V3" Version="3.9.0" />
    <PackageVersion Include="Google.Cloud.Compute.V1" Version="3.10.0" />
    <PackageVersion Include="Google.Cloud.ArtifactRegistry.V1" Version="2.15.0" />
    <PackageVersion Include="Google.Cloud.Scheduler.V1" Version="3.6.0" />
    <PackageVersion Include="Google.Apis.Auth" Version="1.72.0" />
  </ItemGroup>

  <ItemGroup Label="Gateway (YARP + Docker control)">
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.2.0" />
    <PackageVersion Include="Docker.DotNet" Version="3.125.15" />
  </ItemGroup>

  <ItemGroup Label="Physics">
    <PackageVersion Include="AetherNet.Shared" Version="0.1.0" />
    <PackageVersion Include="Aether.Physics2D" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

</Project>
