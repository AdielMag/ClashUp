{
  "nodes": [
    { "id": "c1b2c3d4e5f60001", "type": "text", "x": 0, "y": 0, "width": 260, "height": 90, "color": "4", "text": "# Matchmaking\nQueue by mode; bot-fill if short on humans" },
    { "id": "c1b2c3d4e5f60002", "type": "text", "x": 0, "y": 160, "width": 260, "height": 100, "color": "3", "text": "## Provision\nAssign teams; spawn/route to a backend for the client version" },
    { "id": "c1b2c3d4e5f60003", "type": "text", "x": 0, "y": 320, "width": 260, "height": 90, "color": "5", "text": "## Load + countdown\nLoad map, spawn players, ready-up" },
    { "id": "c1b2c3d4e5f60004", "type": "text", "x": 0, "y": 470, "width": 280, "height": 120, "color": "2", "text": "## Play (server tick)\nAuthoritative sim + snapshots. Inputs, hit detection, scoring." },
    { "id": "c1b2c3d4e5f60005", "type": "text", "x": 380, "y": 470, "width": 300, "height": 120, "color": "6", "text": "## Match end\nFreeze sequence (hide input UI, stop sim), compute results." },
    { "id": "c1b2c3d4e5f60006", "type": "text", "x": 380, "y": 320, "width": 300, "height": 90, "color": "4", "text": "## Results → Lobby\nShow outcome, return to lobby" },
    { "id": "c1b2c3d4e5f60007", "type": "file", "x": 380, "y": 90, "width": 320, "height": 150, "file": "memory/gameplay/elimination-mode.md" }
  ],
