<Project>
  <!--
    Automatic AetherNet.Shared reference switch.
    Local clone (external/AetherNet) → live ProjectReference so you can edit the source.
    Clone absent (Docker / CI) → committed DLL in libs/AetherNet.Shared/ (kept in sync with Unity's copy).
    Run tools/setup-aethernet.ps1 once to create the clone for local dev.
  -->
  <PropertyGroup>
    <_AetherNetSharedSrc>$(MSBuildThisFileDirectory)external\AetherNet\src\AetherNet.Shared\AetherNet.Shared.csproj</_AetherNetSharedSrc>
    <_AetherNetSharedDll>$(MSBuildThisFileDirectory)libs\AetherNet.Shared\AetherNet.Shared.dll</_AetherNetSharedDll>
  </PropertyGroup>
  <Choose>
    <When Condition="Exists('$(_AetherNetSharedSrc)')">
      <ItemGroup>
        <ProjectReference Include="$(_AetherNetSharedSrc)" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <Reference Include="AetherNet.Shared">
          <HintPath>$(_AetherNetSharedDll)</HintPath>
          <Private>true</Private>
        </Reference>
        <Reference Include="Aether.Physics2D">
          <HintPath>$(MSBuildThisFileDirectory)libs\AetherNet.Shared\Aether.Physics2D.dll</HintPath>
          <Private>true</Private>
        </Reference>
      </ItemGroup>
    </Otherwise>
  </Choose>
</Project>
